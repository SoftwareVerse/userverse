ENVIRONMENT=testing
TESTING=true

SERVER_URL=http://localhost:8500
FRONTEND_URL=http://localhost:3000/reset-password
PASSWORD_RESET_EXPIRY_MINUTES=60

DATABASE_URL=sqlite:///./test.db
DB_AUTO_CREATE=true

JWT_SECRET=testing-secret
JWT_ALGORITHM=HS256
