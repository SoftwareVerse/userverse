# Copy to .env and replace development credentials: cp .env.example .env
# Process environment variables override .env values.
ENVIRONMENT=development
TESTING=false
SERVER_URL=http://localhost:8500
FRONTEND_URL=http://localhost:3000/reset-password
PASSWORD_RESET_EXPIRY_MINUTES=60

# Default matches: docker compose --profile postgres up --detach --wait postgres
DATABASE_URL=postgresql+psycopg2://userverse:userverse@127.0.0.1:5432/userverse
# MySQL alternative:
# DATABASE_URL=mysql+pymysql://userverse:userverse@127.0.0.1:3306/userverse
# DATABASE_URL takes precedence over DB_TYPE/DB_* fields.
DB_AUTO_CREATE=false
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

JWT__SECRET=replace-with-a-long-random-secret
JWT__ALGORITHM=HS256
JWT__TIMEOUT=15
JWT__REFRESH_TIMEOUT=60
REQUIRE_EMAIL_VERIFICATION=true

# Lists use JSON syntax; legacy COR_ORIGINS aliases are also accepted.
CORS_ALLOWED=["http://localhost:3000","http://localhost:5173"]
CORS_BLOCKED=[]

# Optional SMTP settings. SSL and TLS cannot both be true.
# EMAIL__HOST=smtp.example.com
# EMAIL__PORT=587
# EMAIL__USERNAME=no-reply@example.com
# EMAIL__PASSWORD=replace-me
# EMAIL__EMAIL_TLS=true
# EMAIL__EMAIL_SSL=false
