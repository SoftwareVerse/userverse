# Copy to .env and replace secrets: cp .env.example .env
# Process environment variables override .env values.
ENV=development
SERVER_URL=http://localhost:8500

# DATABASE_URL takes precedence over DB_* fields.
DATABASE_URL=sqlite:///development.db
# DB_TYPE=postgresql
# DB_USER=userverse
# DB_PASSWORD=replace-me
# DB_NAME=userverse
# DB_HOST=localhost
# DB_PORT=5432

# Lists use JSON syntax; nested settings use two underscores.
COR_ORIGINS__ALLOWED=["http://localhost:3000","http://localhost:5173"]
COR_ORIGINS__BLOCKED=[]
JWT__SECRET=replace-with-a-long-random-secret
JWT__ALGORITHM=HS256
JWT__TIMEOUT=15
JWT__REFRESH_TIMEOUT=60

# Optional SMTP settings
# EMAIL__HOST=smtp.example.com
# EMAIL__PORT=587
# EMAIL__USERNAME=no-reply@example.com
# EMAIL__PASSWORD=replace-me
# EMAIL__EMAIL_TLS=true
# EMAIL__EMAIL_SSL=false
